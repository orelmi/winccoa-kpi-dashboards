"main()
{
  // Load the KPI Configuration HTML via loadSnippet.
  // This injects the oaJsApi library into the page.
  // Path is relative to the WinCC OA web server root (data/ directory).
  this.loadSnippet(\"/webview/index.html\");
}
"
"messageReceived(mapping params)
{
  // Handle commands from JavaScript (oaJsApi.toCtrl)
  // for functions not directly available in oaJsApi.
  string cmd = params[\"cmd\"];

  if (cmd == \"dpSetTimed\")
  {
    // JavaScript sends: {cmd, timestamp (ISO string), dp, value}
    string tsStr = params[\"timestamp\"];
    string dp    = params[\"dp\"];
    float  val   = params[\"value\"];

    time ts = makeTime(tsStr);
    int rc = dpSetTimed(ts, dp, val);

    mapping response;
    response[\"cmd\"]    = \"dpSetTimedResult\";
    response[\"dp\"]     = dp;
    response[\"status\"] = (rc == 0) ? \"ok\" : \"error\";
    this.msgToJs(response);
  }
  else if (cmd == \"dpCreate\")
  {
    string dpName = params[\"dpName\"];
    string dpType = params[\"dpType\"];
    dpCreate(dpName, dpType);
  }
}
"
  E
  E
